{
  "name": "cyberorbit-endpoint-agent",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/cli.js service",
