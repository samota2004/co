generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  MANAGER
  SECURITY_ADMIN
  SYSTEM_ADMIN
}

enum DepartmentType {
  HR
  FINANCE
  ENGINEERING
  SALES
  LEGAL
  EXECUTIVE
  SECURITY
  IT
  MARKETING
  ADMINISTRATION
}

enum AccountStatus {
  ACTIVE
  FROZEN
  INVESTIGATION
  DISABLED
  RESTRICTED
}

enum DeviceStatus {
  TRUSTED
  MONITORED
  SUSPICIOUS
  REVOKED
}

enum ResourceSensitivity {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  HIGHLY_SENSITIVE
}

enum EventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  FILE_ACCESS
  FILE_DOWNLOAD
  PRIVILEGE_ELEVATION
  USB_TRANSFER
  POLICY_VIOLATION
  MODEL_ASSESSMENT
  UNUSUAL_HOURS_ACCESS
  CROSS_DEPT_ACCESS
  MASS_DOWNLOAD
  LOGIN
  LOGOUT
  FAILED_LOGIN
  FILE_UPLOAD
  USB_ACTIVITY
  APPLICATION_ACCESS
  APPLICATION_USAGE
  RESOURCE_ACCESS
  PRIVILEGE_CHANGE
  PASSWORD_CHANGE
  MFA_SUCCESS
  MFA_FAILURE
  CROSS_DEPARTMENT_ACCESS
  SUSPICIOUS_DEVICE
  UNUSUAL_LOCATION
  SHELL_EXECUTION
}

enum EventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
  CRITICAL
}

enum PolicyAction {
  ALLOW
  MONITOR
  MFA
  REQUIRE_APPROVAL
  RESTRICT
  FREEZE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  NEW
  INVESTIGATING
  CONTAINED
  RESOLVED
  FALSE_POSITIVE
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MfaSessionStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

model Department {
  id          String         @id @default(cuid())
  code        DepartmentType @unique
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users     User[]
  resources Resource[]

  @@map("departments")
}

model Role {
  id          String   @id @default(cuid())
  code        UserRole @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  companyId         String         @default("legacy")
  id                String         @id @default(cuid())
  employeeId        String         @unique
  name              String
  email             String         @unique
  passwordHash      String?
  passwordChangedAt DateTime?
  avatarUrl         String?
  roleCode          UserRole       @default(EMPLOYEE)
  role              Role?          @relation(fields: [roleCode], references: [code])
  departmentCode    DepartmentType @default(ENGINEERING)
  department        Department?    @relation(fields: [departmentCode], references: [code])
  status            AccountStatus  @default(ACTIVE)
  deletedAt         DateTime?
  isMainAdmin       Boolean        @default(false)
  authVersion       Int            @default(0)
  assignedAdminId   String?
  assignedAdmin     User? @relation("AdminAssignments", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedPeople    User[] @relation("AdminAssignments")
  managerId         String?
  manager           User?          @relation("ManagedEmployees", fields: [managerId], references: [id], onDelete: SetNull)
  directReports     User[]         @relation("ManagedEmployees")
  trustUpdatedAt    DateTime?

  riskScore  Float         @default(0)
  trustScore Float         @default(100)
  riskLevel  EventSeverity @default(LOW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  behaviorProfile     BehaviorProfile?
  devices             Device[]
  activityEvents      ActivityEvent[]
  incidents           Incident[]
  accessRequests      AccessRequest[]      @relation("UserAccessRequests")
  reviewedRequests    AccessRequest[]      @relation("ReviewerAccessRequests")
  trustHistories      TrustHistory[]
  riskScores          RiskScore[]
  sessions            Session[]
  mfaSessions         MfaSession[]
  passwordResetTokens PasswordResetToken[]
  mlPredictions       MlPrediction[]
  auditLogs           AuditLog[]
  endpointDevices     EndpointDevice[]
  dailyRiskSnapshots  DailyRiskSnapshot[]
  receivedNotifications SecurityNotification[] @relation("NotificationRecipient")

  @@index([roleCode])
  @@index([companyId, managerId])
  @@index([companyId, assignedAdminId])
  @@index([departmentCode])
  @@index([status])
  @@index([riskScore])
  @@index([trustScore])
  @@map("users")
}

model EndpointDevice {
  id             String   @id @default(uuid())
  companyId      String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  name           String
  platform       String
  mappedIdentity String?
  credentialHash String?  @unique
  enrollmentHash String?  @unique
  enrollmentExpiresAt DateTime?
  enrolledAt     DateTime?
  revokedAt      DateTime?
  lastSeen       DateTime?
  agentVersion   String?
  health         Json?
  ipCityEnabled  Boolean  @default(false)
  ipCityGeneration Int    @default(0)
  ipCity         Json?
  config         Json
  createdAt      DateTime @default(now())
  events         EndpointEvent[]
  enforcementCommands EndpointEnforcementCommand[]
  @@index([companyId, userId])
  @@map("endpoint_devices")
}

model EndpointEvent {
  id             String   @id @default(uuid())
  eventId        String
  deviceId       String
  device         EndpointDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  companyId      String
  userId         String?
  version        Int
  type           String
  occurredAt     DateTime
  receivedAt     DateTime @default(now())
  metadata       Json
  @@unique([deviceId, eventId])
  @@index([companyId, userId, occurredAt])
  @@map("endpoint_events")
}

model BehaviorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  normalStartHour     Int      @default(9)
  normalEndHour       Int      @default(18)
  avgDailyDownloadsMB Float    @default(50.0)
  maxNormalDownloadMB Float    @default(200.0)
  typicalLocations    String[] @default(["San Francisco, USA", "HQ Network"])
  allowedDepartments  String[] @default(["ENGINEERING"])
  knownIpSubnets      String[] @default(["10.0.0.0/16", "192.168.1.0/24"])
  offHoursAccessRate  Float    @default(0.02)
  crossDeptAccessRate Float    @default(0.01)
  sampleDays          Int      @default(0)
  trainedThrough      DateTime?
  statistics          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("behavior_profiles")
}

model Device {
  id       String @id @default(cuid())
  deviceId String @unique
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  os          String
  browser     String
  ip          String
  location    String
  trustScore  Float        @default(90)
  isTrusted   Boolean      @default(true)
  status      DeviceStatus @default(TRUSTED)
  fingerprint String?

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityEvents ActivityEvent[]

  @@index([userId])
  @@index([status])
  @@index([trustScore])
  @@index([ip])
  @@map("devices")
}

model Resource {
  protectedData Json?
  companyId      String              @default("legacy")
  id             String              @id @default(cuid())
  resourceId     String              @unique
  name           String
  departmentCode DepartmentType
  department     Department?         @relation(fields: [departmentCode], references: [code])
  sensitivity    ResourceSensitivity @default(INTERNAL)
  requiredRoles  UserRole[]          @default([EMPLOYEE])
  description    String?
  accessCount    Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityEvents ActivityEvent[]
  accessRequests AccessRequest[]

  @@index([departmentCode])
  @@index([companyId, sensitivity])
  @@index([sensitivity])
  @@map("resources")
}

model ActivityEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail String
  userRole  UserRole

  deviceId   String?
  device     Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceName String?

  resourceId   String?
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  resourceName String?

  type      EventType
  timestamp DateTime      @default(now())
  ip        String
  location  String
  severity  EventSeverity @default(INFO)

  riskContribution  Float   @default(0)
  mlAnomalyScore    Float?
  isOffHours        Boolean @default(false)
  isCrossDepartment Boolean @default(false)
  downloadSizeMB    Float?
  failedAttempts    Int?    @default(0)
  metadata          Json?

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deviceId])
  @@index([resourceId])
  @@index([type])
  @@index([severity])
  @@index([timestamp])
  @@map("activity_events")
}

model RiskScore {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score        Float
  level        EventSeverity
  factors      Json
  anomalyScore Float?
  sourceEventId String? @unique
  policyAction String?
  timestamp    DateTime      @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("risk_scores")
}

model TrustHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trustScore Float
  riskScore  Float
  reason     String
  delta      Float    @default(0)
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("trust_histories")
}

model DailyRiskSnapshot {
  id                String   @id @default(cuid())
  companyId         String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day               DateTime @db.Date
  riskScore         Float?
  riskLevel         EventSeverity?
  trustScore        Float?
  trustAsOf         DateTime?
  monitoringStatus  String
  riskFactors       Json
  securityEventIds  Json
  riskAssessmentIds Json
  incidentIds       Json
  sourceCounts      Json
  finalized         Boolean  @default(false)
  finalizedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, day])
  @@index([companyId, day])
  @@index([userId, day])
  @@map("daily_risk_snapshots")
}

model SecurityNotification {
  id          String   @id @default(cuid())
  companyId   String
  recipientId String
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  targetUserId String?
  incidentId  String?
  dedupeKey   String
  type        String
  severity    EventSeverity
  title       String
  message     String
  metadata    Json
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@unique([recipientId, dedupeKey])
  @@index([companyId, recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@map("security_notifications")
}

model EndpointEnforcementCommand {
  id             String        @id @default(cuid())
  commandId      String        @unique @default(uuid())
  companyId      String
  userId         String
  deviceId       String
  device         EndpointDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  action         String
  status         String        @default("PENDING")
  resultCode     String?
  reason         String
  issuedAt       DateTime      @default(now())
  acknowledgedAt DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId, userId, createdAt])
  @@index([deviceId, status, createdAt])
  @@map("endpoint_enforcement_commands")
}

model Incident {
  id          String           @id @default(cuid())
  incidentId  String           @unique
  title       String
  description String?
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(NEW)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail String

  riskScore           Float
  contributingFactors String[]
  mitreTechnique      String?
  aiExplanation       String?
  recommendedAction   String?
  resolutionNotes     String?
  resolvedAt          DateTime?
  resolvedBy          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityEvents ActivityEvent[]

  @@index([userId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@map("incidents")
}

model AccessRequest {
  id        String @id @default(cuid())
  requestId String @unique
  userId    String
  user      User   @relation("UserAccessRequests", fields: [userId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  justification    String
  status           AccessRequestStatus @default(PENDING)
  riskAtRequest    Float               @default(0)
  aiRiskAssessment String?

  reviewedBy        String?
  reviewer          User?     @relation("ReviewerAccessRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)
  decisionReason    String?
  decisionTimestamp DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([resourceId])
  @@index([status])
  @@index([createdAt])
  @@map("access_requests")
}

model AuditLog {
  companyId String   @default("legacy")
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?

  action   String
  category String
  severity EventSeverity @default(INFO)
  details  String
  ip       String?       @default("127.0.0.1")
  metadata Json?

  @@index([userId])
  @@index([companyId, timestamp])
  @@index([category])
  @@index([severity])
  @@index([timestamp])
  @@map("audit_logs")
}

model ZeroTrustPolicy {
  companyId String  @unique @default("legacy")
  config    Json?
  id       String  @id @default(cuid())
  name     String  @default("Default Enterprise Zero Trust Policy")
  isActive Boolean @default(true)

  // Risk thresholds (0 - 100)
  lowRiskMax        Float @default(25)
  mediumRiskMax     Float @default(50)
  highRiskMax       Float @default(75)
  veryHighRiskMax   Float @default(90)
  criticalThreshold Float @default(90)

  // Action triggers
  mfaThreshold         Float @default(40)
  approvalThreshold    Float @default(60)
  restrictionThreshold Float @default(75)
  freezeThreshold      Float @default(90)

  // Weights
  offHoursWeight    Float @default(20)
  crossDeptWeight   Float @default(25)
  volumeWeight      Float @default(25)
  deviceTrustWeight Float @default(15)
  failedLoginWeight Float @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zero_trust_policies")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  refreshHash  String?  @unique
  revokedAt    DateTime?
  mfaVerifiedAt DateTime?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip           String
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

model MfaSession {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeHash  String
  status         MfaSessionStatus @default(PENDING)
  action         String?
  targetResource String?
  attempts       Int              @default(0)
  maxAttempts    Int              @default(5)
  expiresAt      DateTime
  verifiedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("mfa_sessions")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model ModelVersion {
  id              String   @id @default(cuid())
  modelName       String
  version         String
  rocAuc          Float    @default(0.978)
  precision       Float    @default(0.962)
  recall          Float    @default(0.954)
  f1Score         Float    @default(0.958)
  trainingDataset String   @default("CERT Insider Threat Dataset r4.2")
  featureCount    Int      @default(12)
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())

  predictions MlPrediction[]

  @@map("model_versions")
}

model MlPrediction {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelVersionId String?
  modelVersion   ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  featureVector Json
  anomalyScore  Float
  isAnomalous   Boolean
  riskScore     Float
  attributions  Json

  timestamp DateTime @default(now())

  @@index([userId])
  @@index([isAnomalous])
  @@index([timestamp])
  @@map("ml_predictions")
}
