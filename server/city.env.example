# Backend only. Existing employee kits/config/credentials stay unchanged.
ENDPOINT_CITY_ENABLED=true
# Must match the website which issued the key. Default remains ipapi.co.
# Choose ipapi.is for its account-based free tier; never interchange providers' keys.
IPAPI_PROVIDER=ipapi.is
# Required in production, and always required for ipapi.is.
IPAPI_API_KEY=
# Render web service only, after deploying the proxy-policy update:
# TRUST_PROXY=render
# On other hosts use only verified proxy IPs/CIDRs, e.g. TRUST_PROXY=loopback
