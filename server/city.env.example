# Backend only. Existing employee kits/config/credentials stay unchanged.
ENDPOINT_CITY_ENABLED=true
# Required in production. Use an ipapi.co production subscription key.
IPAPI_API_KEY=
# Render web service only, after deploying the proxy-policy update:
# TRUST_PROXY=render
# On other hosts use only verified proxy IPs/CIDRs, e.g. TRUST_PROXY=loopback
